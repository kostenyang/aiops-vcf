# MSSQL 連線設定
# Lab 環境: SQL Server 通常安裝在 AD/跳板機 (10.0.0.200) 或另一台 Windows Server
MSSQL_SERVER=10.0.0.70
MSSQL_PORT=1433
MSSQL_DATABASE=master
MSSQL_USERNAME=sa
MSSQL_PASSWORD=1qaz@WSX3edc

# 驗證方式: sql (SQL Server 驗證) 或 windows (Windows 整合驗證)
MSSQL_AUTH_TYPE=sql

# 安全設定
ALLOW_WRITE=true
ALLOW_DDL=false
MAX_ROWS=1000
QUERY_TIMEOUT=30

# VCF MCP Server Configuration
# Copy this file to /opt/vcf-mcp/.env and fill in your environment values.
# Permissions: chmod 600 /opt/vcf-mcp/.env

# Display name shown in list_environments
ENVIRONMENT_NAME=Production-VCF

# ── vCenter ────────────────────────────────────────────────────────────────────
VCENTER_IP=192.168.1.10
VCENTER_FQDN=vcenter.domain.com
VCENTER_USER=administrator@vsphere.local
VCENTER_PASS=changeme

# ── SDDC Manager ───────────────────────────────────────────────────────────────
SDDC_MANAGER_IP=192.168.1.5
SDDC_MANAGER_USER=administrator@vsphere.local
SDDC_MANAGER_PASS=changeme

# ── VCF Installer / Cloud Builder (optional — leave blank if not in use) ───────
VCF_INSTALLER_IP=
VCF_INSTALLER_USER=admin@local
VCF_INSTALLER_PASS=

# ── Aria Operations / vRealize Operations (optional) ──────────────────────────
VROPS_IP=
VROPS_USER=admin
VROPS_PASS=

# ── SSH defaults (for ESXi hosts and Linux appliances) ────────────────────────
DEFAULT_SSH_USER=root
DEFAULT_SSH_PASS=changeme

# ── Network ────────────────────────────────────────────────────────────────────
DNS_SERVER=192.168.1.1
# Comma-separated ESXi host IPs (used by list_environments)
ESXI_HOSTS=192.168.1.11,192.168.1.12,192.168.1.13,192.168.1.14

# ── Server settings ────────────────────────────────────────────────────────────
MCP_PORT=7000
